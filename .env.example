# DATABASE CONFIGURATION
MONGO_URI=mongodb://localhost:27017/workbenchv2
ADMIN_SECRET=secret

# OWN CONFIGURATION
FRONTEND_URL=http://localhost:8080
PORT=3001
NODE_ENV=develop
AUTH_URL=http://localhost:3005
OPENAI_API_KEY=sk-proj-...
JWT_SECRET=secret
JWT_ISSUER=http://localhost:3005
JWT_AUDIENCE=leia-platform

# PRAIRIELEARN INTEGRATION
# LEIA keeps the receipt private key. PrairieLearn only receives its public JWKS.
LEIA_RECEIPT_PRIVATE_KEY_BASE64=base64-encoded-rsa-private-key-pem
LEIA_RECEIPT_PRIVATE_KEY_FILE=
LEIA_RECEIPT_KEY_ID=leia-receipt-2026-01
# Publish the previous public key here during a rotation overlap.
LEIA_RECEIPT_ADDITIONAL_JWKS_JSON=
# Prefer a PrairieLearn-owned JWKS URL in deployed environments. The direct
# public-key fields are useful for local development only.
PRAIRIELEARN_LAUNCH_JWKS_URL=https://prairielearn.example.edu/.well-known/leia-launch-jwks.json
PRAIRIELEARN_LAUNCH_JWKS_JSON=
PRAIRIELEARN_LAUNCH_PUBLIC_KEY_BASE64=
PRAIRIELEARN_LAUNCH_PUBLIC_KEY_FILE=
PRAIRIELEARN_LAUNCH_KEY_ID=prairielearn-launch-2026-01
PRAIRIELEARN_RECEIPT_ISSUER=leia-workbench
PRAIRIELEARN_RECEIPT_AUDIENCE=prairielearn
PRAIRIELEARN_LAUNCH_ISSUER=prairielearn
PRAIRIELEARN_LAUNCH_AUDIENCE=leia-workbench

# RUNNER CONFIGURATION
RUNNER_URL=http://localhost:5002
RUNNER_KEY=R2D2C3PO

# DESIGNER CONFIGURATION
MANAGER_URL=http://localhost:3000
MANAGER_KEY=secret

# INTERN TOKEN
INTERN_TOKEN=secret_intern_token
